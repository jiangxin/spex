import re
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

from cli import ArgumentParser  # noqa: E402

_skill_dir = _scripts_dir.parent

GROUPED_HELP = """\
Commands (run directly):
  archive [-n] [--topic <topic>]
              Archive completed spec topics (--dry-run to preview)
  config [get] [--all] [var ...]
                Show spex configuration variables
  init          Initialize spex environment
  list [--archives] [--all-projects]
                List spec topics with progress
  merge [topic]
                Merge a spex branch back to target (alias: submit)
  open          Open spec directory in file browser
  show [topic]  Show detailed topic information (-l for brief)

Commands (LLM skill only — invoked via /spex, not directly):
  apply       Apply all steps of a spec (or apply-one-step for single step)
  create      Create a new spec
  modify      Modify an existing spec

Internal commands (used by skill):
  apply-helper <subcommand>
                Helper utilities for applying specs
                (precheck, post-action)
  create-helper <subcommand>
                Helper utilities for spec creation
                (precheck, prepare-spec)
  get-topic [name]
                Resolve a topic directory
  meta <topic_name> [key] [value] [--stdin]
                Get or set key/value in meta.json
  prompt <name> [--topic <topic>] [-o <file>]
                Render a Jinja2 template with metadata
  run-hook <hook_name> --event-type <type> --topic <name>
                Execute a hook script with event data
  todo-helper [--topic <name> | --todo-file <path>] [--xml] <subcmd>
                Operate on todo files (validate, append, edit, remove,
                show, xml2json, json2xml)"""


