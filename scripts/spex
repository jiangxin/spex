#!/usr/bin/env python3
"""Spex - Spec-Driven Development CLI tool."""

import re
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

from cli import ArgumentParser  # noqa: E402

_skill_dir = _scripts_dir.parent

USAGE = """\
Usage: spex <command>

Global options:
  --version, -V       Show version and exit

Commands (run directly):
  archive [-n] [--topic <topic>]
              Archive completed spec topics (--dry-run to preview)
  config [get] [--all] [var ...]
                Show spex configuration variables
  init          Initialize spex environment
  list [--all]  List spec topics with progress (--all includes archived)
  merge --topic <name>
                Merge a spex branch back to target (alias: submit)
  open          Open spec directory in file browser
  show [topic]  Show detailed topic information (-l for brief)

Commands (LLM skill only — invoked via /spex, not directly):
  apply       Apply all steps of a spec (or apply-one-step for single step)
  create      Create a new spec
  modify      Modify an existing spec

Internal commands (used by skill):
  apply-helper <subcommand>
                Helper utilities for applying specs
                (precheck, post-action)
  create-helper <subcommand>
                Helper utilities for spec creation
                (precheck, prepare-spec)
  get-topic [name]
                Resolve a topic directory
  meta <topic_name> <key> [value]
                Set key/value in meta.json (appends if key is "prompts")
                Reads value from stdin if not provided
  prompt <name> [--topic <topic>] [-o <file>]
                Render a Jinja2 template with metadata
  run-hook <hook_name> --event-type <type> --topic <name>
                Execute a hook script with event data
  todo-helper [--topic <name> | --todo-file <path>] [--xml] <subcmd>
                Operate on todo files (validate, append, edit, remove,
                show, xml2json, json2xml)
"""

LLM_COMMANDS = {"apply", "create", "new", "modify"}


def _extract_global_options(argv):
    """Extract --version and -V from argv.

    Returns cleaned_argv with global options removed.
    """
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] in ("--version", "-V"):
            _run_version()
            sys.exit(0)
        else:
            cleaned.append(argv[i])
            i += 1

    return cleaned


def _run_list(argv=None):
    """Run the list command."""
    import list_specs

    list_specs.main(argv)


def _run_archive(argv=None):
    """Run the archive command."""
    import archive_specs

    archive_specs.main(argv)


def _run_show(argv=None):
    """Show detailed topic information."""
    import show_topic

    show_topic.main(argv)


def _run_open(argv=None):
    """Open a topic directory in the system file browser."""
    import open_topic

    open_topic.main(argv)


_CONFIG_USAGE = """\
Usage: spex config [get] [--all] [var ...]

Show spex configuration variables.

Options:
  --all         Show all variables (default when no names given)
  -h, --help    Show this help message and exit
"""


def _build_config_vars(ctx):
    """Build ordered dict of (value, is_list) tuples from SpexContext."""
    all_vars = {}
    # Scalar fields
    all_vars["top_workdir"] = (ctx.top_workdir, False)
    all_vars["main_worktree"] = (ctx.main_worktree, False)
    all_vars["spex_root"] = (ctx.spex_root, False)
    # Expand config dict entries
    for key, val in ctx.config.items():
        all_vars[f"config.{key}"] = (val, False)
    # List fields (displayed last)
    all_vars["spex_tomls"] = (ctx.spex_tomls, True)
    all_vars["spex_roots"] = (ctx.spex_roots, True)
    return all_vars


def _print_config_vars(all_vars, requested):
    """Print config variables in formatted output.

    Args:
        all_vars: Ordered dict of (value, is_list) tuples.
        requested: List of variable names to show, or None for all.
    """
    if requested:
        unknown = [n for n in requested if n not in all_vars]
        if unknown:
            for name in unknown:
                print(f"Error: unknown variable '{name}'",
                      file=sys.stderr)
            sys.exit(1)
        requested_set = set(requested)
        items = [(k, all_vars[k]) for k in all_vars
                 if k in requested_set]
    else:
        items = list(all_vars.items())

    non_list = [(k, v) for k, (v, is_list) in items if not is_list]
    list_items = [(k, v) for k, (v, is_list) in items if is_list]

    for k, v in non_list:
        if v is None:
            print(f"{k}: (none)")
        else:
            print(f"{k}: {v}")

    for k, v in list_items:
        if not v:
            print(f"{k}: (empty)")
        else:
            print(f"{k}:")
            for item in v:
                print(f"- {item}")


def _run_config(argv=None):
    """Show spex configuration variables."""
    import config as spex_config

    if argv is None:
        argv = []

    # Strip "get" subcommand if present
    if argv and argv[0] == "get":
        argv = argv[1:]

    parser = ArgumentParser(prog="spex config", usage=_CONFIG_USAGE)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("names", nargs="*")
    args = parser.parse(argv)

    ctx = spex_config.get_context()
    all_vars = _build_config_vars(ctx)

    if args.names:
        requested = [n.replace("-", "_") for n in args.names]
    else:
        requested = None

    _print_config_vars(all_vars, requested)


def _run_get_topic(argv=None):
    """Resolve a topic directory."""
    import get_topic

    get_topic.main(argv)


def _run_prompt(argv=None):
    """Render a Jinja2 template with metadata."""
    import prompt

    prompt.main(argv)


def _run_meta(argv=None):
    """Set key/value in meta.json."""
    import meta

    meta.main(argv)


def _run_create_helper(argv=None):
    """Route create-helper subcommand."""
    import create_helper

    create_helper.main(argv)


def _run_apply_helper(argv=None):
    """Route apply-helper subcommand."""
    import apply_helper

    apply_helper.main(argv)


_MERGE_USAGE = """\
Usage: spex merge --topic <name>

Merge a spex branch back to target.

Options:
  --topic <name>  Topic name (required)
  -h, --help      Show this help message and exit
"""


def _run_merge(argv=None):
    """Route merge subcommand."""
    import branch

    parser = ArgumentParser(prog="spex merge", usage=_MERGE_USAGE)
    parser.add_argument("--topic")
    args = parser.parse(argv)

    if not args.topic:
        print("Error: --topic is required", file=sys.stderr)
        sys.exit(1)

    branch.cli_submit(["--topic", args.topic])


def _run_todo_helper(argv=None):
    """Route todo-helper subcommands."""
    import todo_helper

    todo_helper.main(argv)


def _get_version():
    """Extract version from SKILL.md front-matter metadata."""
    skill_md = _skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return "unknown"
    content = skill_md.read_text(encoding="utf-8")
    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if not match:
        return "unknown"
    for line in match.group(1).splitlines():
        m = re.match(r"\s*version:\s*(.+)", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return "unknown"


def _run_init(argv=None):
    """Initialize spex environment."""
    import init

    init.main(argv)


_RUN_HOOK_USAGE = """\
Usage: spex run-hook <hook_name> --event-type <type> --topic <name>
       --json-payload '{"key": "value"}'

Execute a hook script with event data.

Options:
  --event-type <type>   Event type (required)
  --topic <name>        Topic name
  --json-payload <json> JSON payload string
  --workdir <path>      Working directory
  -h, --help            Show this help message and exit
"""


def _run_hook(argv=None):
    """Execute a hook script with event data."""
    import json

    import hooks

    parser = ArgumentParser(prog="spex run-hook", usage=_RUN_HOOK_USAGE)
    parser.add_argument("hook_name")
    parser.add_argument("--event-type")
    parser.add_argument("--topic")
    parser.add_argument("--json-payload")
    parser.add_argument("--workdir")
    args = parser.parse(argv)

    if not args.event_type:
        print("Error: --event-type is required", file=sys.stderr)
        sys.exit(1)

    payload = json.loads(args.json_payload or "{}")
    if args.topic:
        payload = {**payload, "topic_name": args.topic}
    event_data = hooks._build_event_data(args.event_type, payload,
                                         args.workdir)
    hooks.run_hook(args.hook_name, event_data, args.workdir)


def _run_version(argv=None):
    """Run the version command."""
    import version

    if argv:
        version.main(argv)
    else:
        print(f"spex {_get_version()}")


DIRECT_COMMANDS = {
    "list": _run_list,
    "show": _run_show,
    "archive": _run_archive,
    "open": _run_open,
    "init": _run_init,
    "config": _run_config,
    "get-topic": _run_get_topic,
"prompt": _run_prompt,
    "meta": _run_meta,
    "todo-helper": _run_todo_helper,
    "create-helper": _run_create_helper,
    "apply-helper": _run_apply_helper,
    "merge": _run_merge,
    "submit": _run_merge,
    "run-hook": _run_hook,
    "version": _run_version,
}


def main(argv=None):
    """CLI entry point."""
    if argv is None:
        argv = sys.argv[1:]

    argv = _extract_global_options(argv)

    if not argv:
        print(USAGE, end="")
        sys.exit(0)

    command = argv[0]

    if command in ("-h", "--help"):
        print(USAGE, end="")
        sys.exit(0)

    if command in DIRECT_COMMANDS:
        DIRECT_COMMANDS[command](argv[1:])
    elif command in LLM_COMMANDS:
        print(
            f"Error: 'spex {command}' requires an AI coding agent. "
            f"Run '/spex {command}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    else:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
