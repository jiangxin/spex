#!/usr/bin/env python3
"""Spex - Spec-Driven Development CLI tool."""

import importlib
import re
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

from cli import ArgumentParser  # noqa: E402

_skill_dir = _scripts_dir.parent

USAGE = """\
Usage: spex <command>

Global options:
  --version, -V       Show version and exit

Commands (run directly):
  list [--all]  List spec topics with progress (--all includes archived)
  show <topic>  Show detailed topic information (-v for full spec)
  archive [-n] [--topic <topic>]
              Archive completed spec topics (--dry-run to preview)
  open          Open spec directory in file browser

Commands (planning — documents only, no code changes):
  create      Create a new spec (aliases: init, new)
  modify      Modify an existing spec

Commands (implementation — modifies code):
  apply       Apply a spec step-by-step

Internal commands (used by skill):
  get --specs-dir|--archives-dir
                Print the requested path
  get-topic [name]
                Resolve a topic directory
  create-topic [--json] [--get <keys>] [--get-prompt <names>] <topic>
                Create a new topic directory
  prompt <name> [--topic <topic>] [-o <file>]
                Render a Jinja2 template with metadata
  meta <topic_name> <key> [value]
                Set key/value in meta.json (appends if key is "prompts")
                Reads value from stdin if not provided
  todo <subcommand> ...
                Operate on todo.json (validate, get-next-undone,
                get-done, mark-done, xml2json, json2xml)
  create-helper --validate
                Validate branch creation feasibility (JSON output)
  apply-helper --validate|--post-action --topic <name>
                Validate or report apply-branch status (JSON/text)
  submit --topic <name>
                Submit (merge) a spex branch back to target
"""

LLM_COMMANDS = {"apply", "create", "new", "modify"}


def _extract_global_options(argv):
    """Extract --version and -V from argv.

    Returns cleaned_argv with global options removed.
    """
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] in ("--version", "-V"):
            _run_version()
            sys.exit(0)
        else:
            cleaned.append(argv[i])
            i += 1

    return cleaned


def _run_list(argv=None):
    """Run the list command."""
    import list_specs

    list_specs.main(argv)


def _run_archive(argv=None):
    """Run the archive command."""
    import archive_specs

    archive_specs.main(argv)


def _run_show(argv=None):
    """Show detailed topic information."""
    import show_topic

    show_topic.main(argv)


def _run_open(argv=None):
    """Open a topic directory in the system file browser."""
    import open_topic

    open_topic.main(argv)


_GET_USAGE = """\
Usage: spex get --specs-dir|--archives-dir

Print the requested path.

Options:
  -h, --help  Show this help message and exit
"""


def _run_get(argv=None):
    """Print a spec path based on the given flag."""
    import common

    parser = ArgumentParser(prog="spex get", usage=_GET_USAGE)
    parser.add_argument("--specs-dir", action="store_true")
    parser.add_argument("--archives-dir", action="store_true")
    args = parser.parse(argv)

    flag_map = {
        "specs_dir": common.get_specs_dir,
        "archives_dir": common.get_archives_dir,
    }

    matched = [k for k in flag_map if getattr(args, k, False)]
    if len(matched) != 1:
        parser.error("exactly one of --specs-dir, --archives-dir is required")

    print(flag_map[matched[0]]())


def _run_get_topic(argv=None):
    """Resolve a topic directory."""
    import get_topic

    get_topic.main(argv)


def _run_create_topic(argv=None):
    """Create a new topic directory."""
    if not argv or len(argv) < 1:
        print("Usage: spex create-topic <topic>", file=sys.stderr)
        sys.exit(1)

    mod = importlib.import_module("create-topic-dir")
    mod.main(argv)


def _run_prompt(argv=None):
    """Render a Jinja2 template with metadata."""
    import prompt

    prompt.main(argv)


def _run_meta(argv=None):
    """Set key/value in meta.json."""
    import meta

    meta.main(argv)


_CREATE_HELPER_USAGE = """\
Usage: spex create-helper --validate

Validate branch creation feasibility.

Options:
  -h, --help  Show this help message and exit
"""


def _run_create_helper(argv=None):
    """Route create-helper subcommand."""
    import branch

    parser = ArgumentParser(prog="spex create-helper",
                            usage=_CREATE_HELPER_USAGE)
    parser.add_argument("--validate", action="store_true")
    args = parser.parse(argv)

    if args.validate:
        branch.cli_create_validate()
    else:
        print("Usage: spex create-helper --validate", file=sys.stderr)
        sys.exit(1)


_APPLY_HELPER_USAGE = """\
Usage: spex apply-helper --validate|--post-action --topic <name>

Validate or report apply-branch status.

Options:
  --validate        Validate branch setup
  --post-action     Run post-action hook
  --topic <name>    Topic name (required)
  -h, --help        Show this help message and exit
"""


def _run_apply_helper(argv=None):
    """Route apply-helper subcommand."""
    import branch

    parser = ArgumentParser(prog="spex apply-helper",
                            usage=_APPLY_HELPER_USAGE)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--validate", action="store_true")
    mode.add_argument("--post-action", action="store_true")
    parser.add_argument("--topic")
    args = parser.parse(argv)

    if args.validate:
        if not args.topic:
            print("Error: --topic is required", file=sys.stderr)
            sys.exit(1)
        branch.cli_apply_validate(["--topic", args.topic])
    elif args.post_action:
        if not args.topic:
            print("Error: --topic is required", file=sys.stderr)
            sys.exit(1)
        branch.cli_apply_post_action(["--topic", args.topic])
    else:
        print(
            "Usage: spex apply-helper --validate|--post-action --topic <name>",
            file=sys.stderr,
        )
        sys.exit(1)


_SUBMIT_USAGE = """\
Usage: spex submit --topic <name>

Submit (merge) a spex branch back to target.

Options:
  --topic <name>  Topic name (required)
  -h, --help      Show this help message and exit
"""


def _run_submit(argv=None):
    """Route submit subcommand."""
    import branch

    parser = ArgumentParser(prog="spex submit", usage=_SUBMIT_USAGE)
    parser.add_argument("--topic")
    args = parser.parse(argv)

    if not args.topic:
        print("Error: --topic is required", file=sys.stderr)
        sys.exit(1)

    branch.cli_submit(["--topic", args.topic])


def _run_todo(argv=None):
    """Route todo subcommands."""
    if not argv or len(argv) < 1:
        print(
            "Usage: spex todo <subcommand> ...\n"
            "Subcommands: validate, get-next-undone, get-done, mark-done,"
            " xml2json, json2xml, remove-undone",
            file=sys.stderr,
        )
        sys.exit(1)

    subcmd = argv[0]
    rest = argv[1:]

    if subcmd in ("-h", "--help"):
        import parse_todo

        print(parse_todo.USAGE, end="")
        sys.exit(0)
    elif subcmd == "mark-done":
        import mark_todo_complete

        mark_todo_complete.main(rest)
    elif subcmd == "xml2json":
        import xml2json_todo

        xml2json_todo.main(rest)
    elif subcmd == "json2xml":
        import json2xml_todo

        json2xml_todo.main(rest)
    elif subcmd == "remove-undone":
        import remove_undone_todo

        remove_undone_todo.main(rest)
    elif subcmd in ("validate", "get-next-undone", "get-done"):
        import parse_todo

        parse_todo.main([subcmd] + rest)
    else:
        print(f"Error: unknown todo subcommand '{subcmd}'", file=sys.stderr)
        print(
            "Subcommands: validate, get-next-undone, get-done, mark-done,"
            " xml2json, json2xml, remove-undone",
            file=sys.stderr,
        )
        sys.exit(1)


def _get_version():
    """Extract version from SKILL.md front-matter metadata."""
    skill_md = _skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return "unknown"
    content = skill_md.read_text(encoding="utf-8")
    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if not match:
        return "unknown"
    for line in match.group(1).splitlines():
        m = re.match(r"\s+version:\s*(.+)", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return "unknown"


def _run_init(argv=None):
    """Initialize spex environment."""
    import init

    init.main(argv)


_RUN_HOOK_USAGE = """\
Usage: spex run-hook <hook_name> --event-type <type> --topic <name>
       --json-payload '{"key": "value"}'

Execute a hook script with event data.

Options:
  --event-type <type>   Event type (required)
  --topic <name>        Topic name
  --json-payload <json> JSON payload string
  --workdir <path>      Working directory
  -h, --help            Show this help message and exit
"""


def _run_hook(argv=None):
    """Execute a hook script with event data."""
    import json

    import hooks

    parser = ArgumentParser(prog="spex run-hook", usage=_RUN_HOOK_USAGE)
    parser.add_argument("hook_name")
    parser.add_argument("--event-type")
    parser.add_argument("--topic")
    parser.add_argument("--json-payload")
    parser.add_argument("--workdir")
    args = parser.parse(argv)

    if not args.event_type:
        print("Error: --event-type is required", file=sys.stderr)
        sys.exit(1)

    payload = json.loads(args.json_payload or "{}")
    if args.topic:
        payload = {**payload, "topic_name": args.topic}
    event_data = hooks._build_event_data(args.event_type, payload,
                                         args.workdir)
    hooks.run_hook(args.hook_name, event_data, args.workdir)


def _run_version(argv=None):  # noqa: ARG001
    """Print version and exit."""
    print(f"spex {_get_version()}")


DIRECT_COMMANDS = {
    "list": _run_list,
    "show": _run_show,
    "archive": _run_archive,
    "open": _run_open,
    "init": _run_init,
    "get": _run_get,
    "get-topic": _run_get_topic,
    "create-topic": _run_create_topic,
    "prompt": _run_prompt,
    "meta": _run_meta,
    "todo": _run_todo,
    "create-helper": _run_create_helper,
    "apply-helper": _run_apply_helper,
    "submit": _run_submit,
    "run-hook": _run_hook,
    "version": _run_version,
}


def main(argv=None):
    """CLI entry point."""
    if argv is None:
        argv = sys.argv[1:]

    argv = _extract_global_options(argv)

    if not argv:
        print(USAGE, end="")
        sys.exit(0)

    command = argv[0]

    if command in ("-h", "--help"):
        print(USAGE, end="")
        sys.exit(0)

    if command in DIRECT_COMMANDS:
        DIRECT_COMMANDS[command](argv[1:])
    elif command in LLM_COMMANDS:
        print(
            f"Error: 'spex {command}' requires an AI coding agent. "
            f"Run '/spex {command}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    else:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
