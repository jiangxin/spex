    """Run the archive command."""
    import archive

    archive.main(argv)


def _run_show(argv=None):
    """Show detailed topic information."""
    import show as spex_show

    spex_show.main(argv)


def _run_open(argv=None):
    """Open a topic directory in the system file browser."""
    import open as spex_open

    spex_open.main(argv)


_CONFIG_USAGE = """\
Usage: spex config [get] [--all] [var ...]

Show spex configuration variables.

Options:
  --all         Show all variables (default when no names given)
  -h, --help    Show this help message and exit
"""


def _build_config_vars(ctx):
    """Build ordered dict of (value, is_list) tuples from ProjectContext."""
    all_vars = {}
    # Scalar fields
    all_vars["cwd"] = (ctx.cwd, False)
    all_vars["top_workdir"] = (ctx.top_workdir, False)
    all_vars["main_worktree"] = (ctx.main_worktree, False)
    all_vars["remote_url"] = (ctx.remote_url, False)
    all_vars["branch"] = (ctx.branch, False)
    all_vars["user_name"] = (ctx.user_name, False)
    all_vars["user_email"] = (ctx.user_email, False)
    all_vars["spex_root"] = (ctx.spex_root, False)
    # Expand config dict entries
    for key, val in ctx.config.items():
        all_vars[f"config.{key}"] = (val, False)
    # List fields (displayed last)
    all_vars["spex_tomls"] = (ctx.spex_tomls, True)
    all_vars["spex_roots"] = (ctx.spex_roots, True)
    return all_vars


def _print_config_vars(all_vars, requested):
    """Print config variables in formatted output.

    Args:
        all_vars: Ordered dict of (value, is_list) tuples.
        requested: List of variable names to show, or None for all.
    """
    if requested:
        unknown = [n for n in requested if n not in all_vars]
        if unknown:
            for name in unknown:
                print(f"Error: unknown variable '{name}'",
                      file=sys.stderr)
            sys.exit(1)
        requested_set = set(requested)
        items = [(k, all_vars[k]) for k in all_vars
                 if k in requested_set]
    else:
        items = list(all_vars.items())

    non_list = [(k, v) for k, (v, is_list) in items if not is_list]
    list_items = [(k, v) for k, (v, is_list) in items if is_list]

    max_key = max((len(k) for k, _ in items), default=0)

    for k, v in non_list:
        label = k.ljust(max_key)
        if v is None:
            print(f"{label} : (none)")
        else:
            print(f"{label} : {v}")

    for k, v in list_items:
        label = k.ljust(max_key)
        if not v:
            print(f"{label} : (empty)")
        else:
            print(f"{label} :")
            for item in v:
                print(f"  - {item}")


def _run_config(argv=None):
    """Show spex configuration variables."""
    import config as spex_config

    if argv is None:
        argv = []

    # Strip "get" subcommand if present
    if argv and argv[0] == "get":
        argv = argv[1:]

    parser = ArgumentParser(prog="spex config", usage=_CONFIG_USAGE)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("names", nargs="*")
    args = parser.parse(argv)

    ctx = spex_config.get_project_context()
    all_vars = _build_config_vars(ctx)

    if args.names:
        requested = [n.replace("-", "_") for n in args.names]
    else:
        requested = None

    _print_config_vars(all_vars, requested)


def _run_get_topic(argv=None):
    """Resolve a topic directory."""
    import get_topic

    get_topic.main(argv)


def _run_prompt(argv=None):
    """Render a Jinja2 template with metadata."""
    import prompt

