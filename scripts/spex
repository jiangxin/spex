_MERGE_USAGE = """\
Usage: spex merge [topic] [--no-archive]

Merge a spex branch back to target.

Positional arguments:
  topic           Topic name (required)

Options:
  --no-archive    Skip automatic archiving after successful merge
  -h, --help      Show this help message and exit
"""


def _run_merge(argv=None):
    """Route merge subcommand."""
    import merge

    parser = ArgumentParser(prog="spex merge", usage=_MERGE_USAGE)
    parser.add_argument("topic", nargs="?", default="")
    parser.add_argument("--no-archive", action="store_true")
    args = parser.parse(argv)

    if not args.topic:
        print("Error: topic argument is required", file=sys.stderr)
        sys.exit(1)

    submit_args = [args.topic]
    if args.no_archive:
        submit_args.append("--no-archive")
    merge.cli_submit(submit_args)


def _run_todo_helper(argv=None):
    """Route todo-helper subcommands."""
    import todo_helper

    todo_helper.main(argv)


def _get_version():
    """Extract version from SKILL.md front-matter metadata."""
    skill_md = _skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return "unknown"
    content = skill_md.read_text(encoding="utf-8")
    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if not match:
        return "unknown"
    for line in match.group(1).splitlines():
        m = re.match(r"\s*version:\s*(.+)", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return "unknown"


def _run_init(argv=None):
    """Initialize spex environment."""
    import init

    init.main(argv)


_RUN_HOOK_USAGE = """\
Usage: spex run-hook <hook_name> --event-type <type> --topic <name>
       --json-payload '{"key": "value"}'

Execute a hook script with event data.

Options:
  --event-type <type>   Event type (required)
  --topic <name>        Topic name
  --json-payload <json> JSON payload string
  --workdir <path>      Working directory
  -h, --help            Show this help message and exit
"""


def _run_hook(argv=None):
    """Execute a hook script with event data."""
    import json

    import hooks

    parser = ArgumentParser(prog="spex run-hook", usage=_RUN_HOOK_USAGE)
    parser.add_argument("hook_name")
    parser.add_argument("--event-type")
    parser.add_argument("--topic")
    parser.add_argument("--json-payload")
    parser.add_argument("--workdir")
    args = parser.parse(argv)

    if not args.event_type:
        print("Error: --event-type is required", file=sys.stderr)
        sys.exit(1)

    payload = json.loads(args.json_payload or "{}")
    if args.topic:
        payload = {**payload, "topic_name": args.topic}
    event_data = hooks._build_event_data(args.event_type, payload,
                                         args.workdir)
    hooks.run_hook(args.hook_name, event_data, args.workdir)


def _run_version(argv=None):
    """Run the version command."""
    import version

    if argv:
        version.main(argv)
    else:
        print(f"spex {_get_version()}")


def _make_llm_error_handler(name):
    """Create a handler for LLM-only commands."""
    def handler(argv=None):
        print(
            f"Error: 'spex {name}' requires an AI coding agent. "
            f"Run '/spex {name}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    return handler


# -- Command registries ---------------------------------------------------

_CLI_COMMANDS = [
    ("archive", _run_archive),
    ("config", _run_config),
    ("init", _run_init),
    ("list", _run_list),
    ("merge", _run_merge),
    ("submit", _run_merge),
    ("open", _run_open),
    ("show", _run_show),
]

_LLM_COMMAND_NAMES = ["apply", "create", "modify", "new"]

_INTERNAL_COMMANDS = [
    ("apply-helper", _run_apply_helper),
    ("create-helper", _run_create_helper),
    ("get-topic", _run_get_topic),
    ("meta", _run_meta),
    ("prompt", _run_prompt),
    ("run-hook", _run_hook),
    ("todo-helper", _run_todo_helper),
    ("version", _run_version),
]

_ALL_COMMANDS = (
    {name for name, _ in _CLI_COMMANDS}
    | set(_LLM_COMMAND_NAMES)
    | {name for name, _ in _INTERNAL_COMMANDS}
)


def _build_parser():
    """Build the main argument parser with grouped help."""
    parser = argparse.ArgumentParser(
        prog="spex",
        usage="spex <command>",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=GROUPED_HELP,
        allow_abbrev=False,
    )
    parser.add_argument(
        "--version", "-V",
        action="version",
        version=f"spex {_get_version()}",
        help="Show version and exit",
    )

    subs = parser.add_subparsers(dest="command")

    for name, func in _CLI_COMMANDS:
        p = subs.add_parser(name, add_help=False)
        p.set_defaults(func=func)

    for name in _LLM_COMMAND_NAMES:
        p = subs.add_parser(name, add_help=False)
        p.set_defaults(func=_make_llm_error_handler(name))

    for name, func in _INTERNAL_COMMANDS:
        p = subs.add_parser(name, add_help=False)
        p.set_defaults(func=func)

    # Hide the default subparser listing from help output; the grouped
    # command descriptions are shown via the epilog instead.
    for ag in parser._action_groups:
        ag._group_actions = [
            a for a in ag._group_actions
            if not isinstance(a, argparse._SubParsersAction)
        ]

    return parser


def main(argv=None):
    """CLI entry point."""
    if argv is None:
        argv = sys.argv[1:]

    parser = _build_parser()
    argv = list(argv)

    # Normalize subcommand: underscores -> hyphens (for display-name
    # matching).  Also pre-check for unknown commands so we can produce
    # the same error format as before (argparse would exit with code 2).
    for i, arg in enumerate(argv):
        if not arg.startswith("-"):
            argv[i] = arg.replace("_", "-")
            if argv[i] not in _ALL_COMMANDS:
                print(f"Unknown command: {argv[i]}\n", file=sys.stderr)
                parser.print_help(sys.stderr)
                sys.exit(1)
            break

    args, remaining = parser.parse_known_args(argv)

    if args.command is None:
        parser.print_help()
        sys.exit(0)

    args.func(remaining)


if __name__ == "__main__":
    main()
