#!/usr/bin/env python3
"""Spex - Spec-Driven Development CLI tool."""

import importlib
import os
import re
import shutil
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

_skill_dir = _scripts_dir.parent

USAGE = """\
Usage: spex [--spex-root <path>] <command>

Global options:
  --spex-root <path>  Override spex root directory
  --version, -V       Show version and exit

Commands (run directly):
  list [--all]  List spec topics with progress (--all includes archived)
  show <topic>  Show detailed topic information (-v for full spec)
  archive [-n]  Archive completed spec topics (--dry-run to preview)
  open          Open spec directory in file browser
  install-cli [path]  Install spex symlink (default: ~/.local/bin)

Commands (require AI coding agent):
  apply       Apply a spec step-by-step
  create      Create a new spec (aliases: init, new)
  modify      Modify an existing spec

Internal commands (used by skill):
  get --spex-root|--specs-dir|--archives-dir
                Print the requested path
  get-topic [name]
                Resolve a topic directory
  create-topic [--json] [--get <keys>] [--get-prompt <names>] <topic>
                Create a new topic directory
  prompt <name> [--topic <topic>] [-o <file>]
                Render a Jinja2 template with metadata
  meta <topic_name> <key> [value]
                Set key/value in meta.json (appends if key is "prompts")
                Reads value from stdin if not provided
  todo <subcommand> ...
                Operate on todo.json (validate, get-next-undone,
                get-done, mark-done, xml2json, json2xml)
"""

LLM_COMMANDS = {"apply", "create", "new", "modify"}


def _run_list():
    """Run the list command."""
    import list_specs

    list_specs.main()


def _run_archive():
    """Run the archive command."""
    import archive_specs

    archive_specs.main()


def _run_show():
    """Show detailed topic information."""
    import show_topic

    sys.argv = ["show_topic.py"] + sys.argv[2:]
    show_topic.main()


def _run_open():
    """Open a topic directory in the system file browser."""
    import open_topic

    sys.argv = ["open_topic.py"] + sys.argv[2:]
    open_topic.main()


_INSTALL_USAGE = """\
Usage: spex install-cli [path]

Install spex symlink (default: ~/.local/bin).

Options:
  -h, --help  Show this help message and exit
"""


def _run_install():
    """Install spex symlink to a directory (default ~/.local/bin)."""
    script_path = Path(__file__).resolve()

    args = sys.argv[2:]

    if "-h" in args or "--help" in args:
        print(_INSTALL_USAGE, end="")
        sys.exit(0)

    if args:
        target = args[0].rstrip("/")
        if target.endswith("/spex"):
            target = target[: -len("/spex")]
        link_dir = Path(target).expanduser().resolve()
    else:
        link_dir = Path.home() / ".local" / "bin"

    link_path = link_dir / "spex"

    try:
        link_dir.mkdir(parents=True, exist_ok=True)
    except PermissionError:
        print(
            f"Error: permission denied creating {link_dir}\n"
            f"Try: sudo spex install-cli {link_dir}",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        if link_path.is_symlink() or link_path.exists():
            link_path.unlink()
        link_path.symlink_to(script_path)
    except PermissionError:
        print(
            f"Error: permission denied writing {link_path}\n"
            f"Try: sudo spex install-cli {link_dir}",
            file=sys.stderr,
        )
        sys.exit(1)

    print(f"Installed: {link_path} -> {script_path}")

    _check_path(link_dir)


def _check_path(link_dir: Path):
    """Check if spex is reachable via PATH and print hint if not."""
    found = shutil.which("spex")
    if found and Path(found).resolve() == (link_dir / "spex").resolve():
        return
    print(
        f"\nNote: {link_dir} is not in your PATH.\n"
        f"Add this to your shell profile (~/.bashrc, ~/.zshrc, etc.):\n"
        f'  export PATH="$HOME/.local/bin:$PATH"',
    )


_GET_USAGE = """\
Usage: spex get --spex-root|--specs-dir|--archives-dir

Print the requested path.

Options:
  -h, --help  Show this help message and exit
"""


def _run_get():
    """Print a spec path based on the given flag."""
    import common

    flags = sys.argv[2:]

    if "-h" in flags or "--help" in flags:
        print(_GET_USAGE, end="")
        sys.exit(0)

    flag_map = {
        "--spex-root": common.get_spex_root,
        "--specs-dir": common.get_specs_dir,
        "--archives-dir": common.get_archives_dir,
    }

    if len(flags) != 1 or flags[0] not in flag_map:
        print(
            "Usage: spex get --spex-root|--specs-dir|--archives-dir",
            file=sys.stderr,
        )
        sys.exit(1)

    print(flag_map[flags[0]]())


def _run_get_topic():
    """Resolve a topic directory."""
    import get_topic

    sys.argv = ["get_topic.py"] + sys.argv[2:]
    get_topic.main()


def _run_create_topic():
    """Create a new topic directory."""
    if len(sys.argv) < 3:
        print("Usage: spex create-topic <topic>", file=sys.stderr)
        sys.exit(1)

    mod = importlib.import_module("create-topic-dir")
    sys.argv = ["create-topic-dir.py"] + sys.argv[2:]
    mod.main()


def _run_prompt():
    """Render a Jinja2 template with metadata."""
    import prompt

    sys.argv = ["prompt.py"] + sys.argv[2:]
    prompt.main()


def _run_meta():
    """Set key/value in meta.json."""
    import meta

    sys.argv = ["meta.py"] + sys.argv[2:]
    meta.main()


def _run_todo():
    """Route todo subcommands."""
    if len(sys.argv) < 3:
        print(
            "Usage: spex todo <subcommand> ...\n"
            "Subcommands: validate, get-next-undone, get-done, mark-done,"
            " xml2json, json2xml, remove-undone",
            file=sys.stderr,
        )
        sys.exit(1)

    subcmd = sys.argv[2]

    if subcmd in ("-h", "--help"):
        import parse_todo

        print(parse_todo.USAGE, end="")
        sys.exit(0)
    elif subcmd == "mark-done":
        import mark_todo_complete

        sys.argv = ["mark_todo_complete.py"] + sys.argv[3:]
        mark_todo_complete.main()
    elif subcmd == "xml2json":
        import xml2json_todo

        sys.argv = ["xml2json_todo.py"] + sys.argv[3:]
        xml2json_todo.main()
    elif subcmd == "json2xml":
        import json2xml_todo

        sys.argv = ["json2xml_todo.py"] + sys.argv[3:]
        json2xml_todo.main()
    elif subcmd == "remove-undone":
        import remove_undone_todo

        sys.argv = ["remove_undone_todo.py"] + sys.argv[3:]
        remove_undone_todo.main()
    elif subcmd in ("validate", "get-next-undone", "get-done"):
        import parse_todo

        sys.argv = ["parse_todo.py", subcmd] + sys.argv[3:]
        parse_todo.main()
    else:
        print(f"Error: unknown todo subcommand '{subcmd}'", file=sys.stderr)
        print(
            "Subcommands: validate, get-next-undone, get-done, mark-done,"
            " xml2json, json2xml, remove-undone",
            file=sys.stderr,
        )
        sys.exit(1)


def _get_version():
    """Extract version from SKILL.md front-matter metadata."""
    skill_md = _skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return "unknown"
    content = skill_md.read_text(encoding="utf-8")
    match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if not match:
        return "unknown"
    for line in match.group(1).splitlines():
        m = re.match(r"\s+version:\s*(.+)", line)
        if m:
            return m.group(1).strip().strip("\"'")
    return "unknown"


def _run_init():
    """Initialize spex environment."""
    import init

    init.main()


def _run_version():
    """Print version and exit."""
    print(f"spex {_get_version()}")


DIRECT_COMMANDS = {
    "list": _run_list,
    "show": _run_show,
    "archive": _run_archive,
    "open": _run_open,
    "init": _run_init,
    "install-cli": _run_install,
    "install": _run_install,
    "get": _run_get,
    "get-topic": _run_get_topic,
    "create-topic": _run_create_topic,
    "prompt": _run_prompt,
    "meta": _run_meta,
    "todo": _run_todo,
    "version": _run_version,
}


def _extract_global_options():
    """Extract --spex-root from sys.argv at any position.

    Distinguishes the global option (which always has a value) from the
    'get --spex-root' subcommand flag (which has no value).
    """
    args = sys.argv[1:]
    if "--version" in args or "-V" in args:
        _run_version()
        sys.exit(0)

    new_args = []
    spex_root = None
    i = 0
    while i < len(args):
        if args[i].startswith("--spex-root="):
            spex_root = args[i].split("=", 1)[1]
            if not spex_root:
                print("Error: --spex-root requires a path argument",
                      file=sys.stderr)
                sys.exit(1)
            i += 1
        elif args[i] == "--spex-root" and i + 1 < len(args) and not args[i + 1].startswith("-"):
            spex_root = args[i + 1]
            i += 2
        else:
            new_args.append(args[i])
            i += 1

    if spex_root is not None:
        os.environ["SPEX_ROOT"] = spex_root
        import config

        config.clear_config_cache()
    elif "--spex-root" in args and args[-1] == "--spex-root":
        # Bare --spex-root at end with no value and no command context
        if not any(a in DIRECT_COMMANDS or a in LLM_COMMANDS for a in args[:-1]):
            print("Error: --spex-root requires a path argument",
                  file=sys.stderr)
            sys.exit(1)
        new_args = args

    sys.argv = [sys.argv[0]] + new_args


def main():
    """CLI entry point."""
    _extract_global_options()

    if len(sys.argv) < 2:
        print(USAGE, end="")
        sys.exit(0)

    command = sys.argv[1]

    if command in ("-h", "--help"):
        print(USAGE, end="")
        sys.exit(0)

    if command in DIRECT_COMMANDS:
        DIRECT_COMMANDS[command]()
    elif command in LLM_COMMANDS:
        print(
            f"Error: 'spex {command}' requires an AI coding agent. "
            f"Run '/spex {command}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    else:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
