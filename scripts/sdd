#!/usr/bin/env python3
"""SDD - Spec-Driven Development CLI tool."""

import os
import shutil
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

USAGE = """\
Usage: sdd <command>

Commands (run directly):
  list        List active spec topics with progress
  list-all    List all spec topics including archived
  archive     Archive completed spec topics
  install     Install sdd symlink to ~/.local/bin

Commands (require AI coding agent):
  apply       Apply a spec step-by-step
  create      Create a new spec (aliases: init, new)
  modify      Modify an existing spec
  edit        Edit spec details
"""

LLM_COMMANDS = {"apply", "create", "init", "new", "modify", "edit"}


def _run_list():
    """Run the list command."""
    import list_specs

    list_specs.main()


def _run_list_all():
    """Run the list-all command (list with --all flag)."""
    import list_specs

    sys.argv.append("--all")
    list_specs.main()


def _run_archive():
    """Run the archive command."""
    import archive_specs

    archive_specs.main()


def _run_install():
    """Install sdd symlink to ~/.local/bin."""
    script_path = Path(__file__).resolve()
    link_dir = Path.home() / ".local" / "bin"
    link_path = link_dir / "sdd"

    link_dir.mkdir(parents=True, exist_ok=True)

    if link_path.is_symlink():
        if link_path.resolve() == script_path:
            print("Already installed.")
            return
        print(
            f"Error: {link_path} already exists and points to "
            f"{os.readlink(link_path)}",
            file=sys.stderr,
        )
        sys.exit(1)

    if link_path.exists():
        print(
            f"Error: {link_path} already exists and is not a symlink.",
            file=sys.stderr,
        )
        sys.exit(1)

    link_path.symlink_to(script_path)
    print(f"Installed: {link_path} -> {script_path}")

    _check_path(link_dir)


def _check_path(link_dir: Path):
    """Check if sdd is reachable via PATH and print hint if not."""
    found = shutil.which("sdd")
    if found and Path(found).resolve() == (link_dir / "sdd").resolve():
        return
    print(
        f"\nNote: {link_dir} is not in your PATH.\n"
        f"Add this to your shell profile (~/.bashrc, ~/.zshrc, etc.):\n"
        f'  export PATH="$HOME/.local/bin:$PATH"',
    )


DIRECT_COMMANDS = {
    "list": _run_list,
    "list-all": _run_list_all,
    "archive": _run_archive,
    "install": _run_install,
}


def main():
    """CLI entry point."""
    if len(sys.argv) < 2:
        print(USAGE, end="")
        sys.exit(0)

    command = sys.argv[1]

    if command in DIRECT_COMMANDS:
        DIRECT_COMMANDS[command]()
    elif command in LLM_COMMANDS:
        print(
            f"Error: 'sdd {command}' requires an AI coding agent. "
            f"Run '/sdd {command}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    else:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
