#!/usr/bin/env python3
"""SDD - Spec-Driven Development CLI tool."""

import importlib
import os
import shutil
import sys
from pathlib import Path

# Add scripts/ to sys.path for sibling imports.
_scripts_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(_scripts_dir))

USAGE = """\
Usage: sdd <command>

Commands (run directly):
  list        List active spec topics with progress
  list-all    List all spec topics including archived
  archive     Archive completed spec topics
  open        Open spec directory in file browser
  install     Install sdd symlink to ~/.local/bin

Commands (require AI coding agent):
  apply       Apply a spec step-by-step
  create      Create a new spec (aliases: init, new)
  modify      Modify an existing spec

Internal commands (used by skill):
  get --spec-root|--specs-dir|--archives-dir
                Print the requested path
  get-topic [name]
                Resolve a topic directory
  create-topic <topic>
                Create a new topic directory
  write-log <topic>
                Read prompt from stdin and log to prompt.log
  todo <subcommand> ...
                Operate on todo.json (validate, get-next-undone,
                get-done, mark-done)
"""

LLM_COMMANDS = {"apply", "create", "init", "new", "modify"}


def _run_list():
    """Run the list command."""
    import list_specs

    list_specs.main()


def _run_list_all():
    """Run the list-all command (list with --all flag)."""
    import list_specs

    sys.argv.append("--all")
    list_specs.main()


def _run_archive():
    """Run the archive command."""
    import archive_specs

    archive_specs.main()


def _run_open():
    """Open a topic directory in the system file browser."""
    import open_topic

    sys.argv = ["open_topic.py"] + sys.argv[2:]
    open_topic.main()


def _run_install():
    """Install sdd symlink to ~/.local/bin."""
    script_path = Path(__file__).resolve()
    link_dir = Path.home() / ".local" / "bin"
    link_path = link_dir / "sdd"

    link_dir.mkdir(parents=True, exist_ok=True)

    if link_path.is_symlink():
        if link_path.resolve() == script_path:
            print("Already installed.")
            return
        print(
            f"Error: {link_path} already exists and points to "
            f"{os.readlink(link_path)}",
            file=sys.stderr,
        )
        sys.exit(1)

    if link_path.exists():
        print(
            f"Error: {link_path} already exists and is not a symlink.",
            file=sys.stderr,
        )
        sys.exit(1)

    link_path.symlink_to(script_path)
    print(f"Installed: {link_path} -> {script_path}")

    _check_path(link_dir)


def _check_path(link_dir: Path):
    """Check if sdd is reachable via PATH and print hint if not."""
    found = shutil.which("sdd")
    if found and Path(found).resolve() == (link_dir / "sdd").resolve():
        return
    print(
        f"\nNote: {link_dir} is not in your PATH.\n"
        f"Add this to your shell profile (~/.bashrc, ~/.zshrc, etc.):\n"
        f'  export PATH="$HOME/.local/bin:$PATH"',
    )


def _run_get():
    """Print a spec path based on the given flag."""
    import common

    flags = sys.argv[2:]
    flag_map = {
        "--spec-root": common.get_specs_root,
        "--specs-dir": common.get_specs_dir,
        "--archives-dir": common.get_archives_dir,
    }

    if len(flags) != 1 or flags[0] not in flag_map:
        print(
            "Usage: sdd get --spec-root|--specs-dir|--archives-dir",
            file=sys.stderr,
        )
        sys.exit(1)

    print(flag_map[flags[0]]())


def _run_get_topic():
    """Resolve a topic directory."""
    import get_topic

    sys.argv = ["get_topic.py"] + sys.argv[2:]
    get_topic.main()


def _run_create_topic():
    """Create a new topic directory."""
    if len(sys.argv) < 3:
        print("Usage: sdd create-topic <topic>", file=sys.stderr)
        sys.exit(1)

    mod = importlib.import_module("create-topic-dir")
    sys.argv = ["create-topic-dir.py"] + sys.argv[2:]
    mod.main()


def _run_write_log():
    """Log a prompt to a topic's prompt.log."""
    if len(sys.argv) < 3:
        print("Usage: sdd write-log <topic>", file=sys.stderr)
        sys.exit(1)

    mod = importlib.import_module("write-log")
    sys.argv = ["write-log.py"] + sys.argv[2:]
    mod.main()


def _run_todo():
    """Route todo subcommands."""
    if len(sys.argv) < 3:
        print(
            "Usage: sdd todo <subcommand> ...\n"
            "Subcommands: validate, get-next-undone, get-done, mark-done",
            file=sys.stderr,
        )
        sys.exit(1)

    subcmd = sys.argv[2]

    if subcmd == "mark-done":
        import mark_todo_complete

        sys.argv = ["mark_todo_complete.py"] + sys.argv[3:]
        mark_todo_complete.main()
    elif subcmd in ("validate", "get-next-undone", "get-done"):
        import parse_todo

        sys.argv = ["parse_todo.py", subcmd] + sys.argv[3:]
        parse_todo.main()
    else:
        print(f"Error: unknown todo subcommand '{subcmd}'", file=sys.stderr)
        print(
            "Subcommands: validate, get-next-undone, get-done, mark-done",
            file=sys.stderr,
        )
        sys.exit(1)


DIRECT_COMMANDS = {
    "list": _run_list,
    "list-all": _run_list_all,
    "archive": _run_archive,
    "open": _run_open,
    "install": _run_install,
    "get": _run_get,
    "get-topic": _run_get_topic,
    "create-topic": _run_create_topic,
    "write-log": _run_write_log,
    "todo": _run_todo,
}


def main():
    """CLI entry point."""
    if len(sys.argv) < 2:
        print(USAGE, end="")
        sys.exit(0)

    command = sys.argv[1]

    if command in DIRECT_COMMANDS:
        DIRECT_COMMANDS[command]()
    elif command in LLM_COMMANDS:
        print(
            f"Error: 'sdd {command}' requires an AI coding agent. "
            f"Run '/sdd {command}' in Claude Code or equivalent.",
            file=sys.stderr,
        )
        sys.exit(1)
    else:
        print(f"Unknown command: {command}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
